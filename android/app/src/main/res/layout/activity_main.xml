<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- 1. LUXURY HEADER BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Brand Logo Emblem -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_printsheba_logo"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PrintSheba Pay"
                    android:textColor="@color/text_high"
                    android:textSize="20sp"
                    android:letterSpacing="0.02"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="বিকাশ ও নগদ অটো-এসএমএস লিসেনার"
                    android:textColor="@color/brand_cyan_start"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Realtime Live Badge -->
            <TextView
                android:id="@+id/tvLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="● সক্রিয়"
                android:textColor="@color/status_green_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Vibrant Gradient Accent Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/brand_rose_start" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Permission Alert Banner -->
            <LinearLayout
                android:id="@+id/layoutPermissionAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ এসএমএস রিড পারমিশন প্রয়োজন"
                    android:textColor="#F87171"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="বিকাশ ও নগদের এসএমএস পড়ে গ্রাহকের প্রিন্ট স্বয়ংক্রিয়ভাবে চালু করার জন্য নিচের বাটনে চাপ দিয়ে পারমিশন দিন।"
                    android:textColor="@color/text_medium"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="পারমিশন দিন"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. SERVICE SWITCH CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="২৪/৭ অটোমেটিক লিসেনার"
                            android:textColor="@color/text_high"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ব্যাকগ্রাউন্ডে চালু থাকলে এসএমএস আসামাত্রই টাকা যাচাই হবে"
                            android:textColor="@color/text_medium"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- 3. CONFIGURATION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚙️ ক্লাউড সার্ভার ও শপ সংযোগ"
                        android:textColor="@color/text_high"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTestHeartbeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সংযোগ যাচাই"
                        android:textColor="@color/brand_cyan_start"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Server URL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="সার্ভার URL (ডোমেইন বা লোকাল আইপি):"
                    android:textColor="@color/text_medium"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_modern"
                    android:hint="https://yourprintshop.com"
                    android:textColorHint="@color/text_muted"
                    android:inputType="textUri"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_high"
                    android:textSize="13sp" />

                <!-- API Token -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="দোকানের সিক্রেট API Token:"
                    android:textColor="@color/text_medium"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApiToken"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_modern"
                    android:hint="শপ সেটিংস থেকে টোকেন কপি করুন..."
                    android:textColorHint="@color/text_muted"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_high"
                    android:textSize="13sp" />

                <!-- Save Settings Button -->
                <Button
                    android:id="@+id/btnSaveConfig"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="💾 সেটিংস সেভ করুন"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 4. SIMULATION & TEST BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪 ডেমো টেস্ট পেমেন্ট (ভার্চুয়াল টেস্ট)"
                    android:textColor="@color/text_high"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="আসল টাকা না পাঠিয়ে সরাসরি সিস্টেম যাচাই করতে নিচের বাটনে চাপ দিন।"
                    android:textColor="@color/text_medium"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- bKash Test Button -->
                    <Button
                        android:id="@+id/btnTestBkash"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_bkash"
                        android:text="বিকাশ টেস্ট (৳২০)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Nagad Test Button -->
                    <Button
                        android:id="@+id/btnTestNagad"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_nagad"
                        android:text="নগদ টেস্ট (৳৫০)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- 5. RECENT TRANSACTIONS LOG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 রিয়েল-টাইম ট্রানজেকশন লগ"
                        android:textColor="@color/text_high"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="লগ ক্লিয়ার"
                        android:textColor="@color/brand_rose_start"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_modern"
                    android:fontFamily="monospace"
                    android:minLines="5"
                    android:lineSpacingExtra="3dp"
                    android:padding="16dp"
                    android:text="এখনো কোনো ট্রানজেকশন আসেনি..."
                    android:textColor="#CBD5E1"
                    android:textSize="11.5sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>